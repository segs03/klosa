# copy to /etc/klosa/env owned by klosa

DJANGO_DEBUG=0
SECRET_KEY=            # python -c "import secrets;print(secrets.token_urlsafe(64))"
IDENTITY_HASH_KEY=     # another one, never the same value
TOTP_ENCRYPTION_KEY=   # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ALLOWED_HOSTS=bank.example.com
CSRF_TRUSTED_ORIGINS=https://bank.example.com
SITE_URL=https://bank.example.com
ADMIN_URL=ops-change-this-random-words/
DB_NAME=klosadb
DB_USER=klosa
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_SSLMODE=prefer
REDIS_URL=redis://:password@127.0.0.1:6379/1
TRUST_REAL_IP_HEADER=1
STAFF_2FA_REQUIRED=1
SESSION_IDLE_SECONDS=900
SMS_BACKEND=accounts.sms.send_sms
KLOSA_BANK_CODE=
FEATURE_BILLS=0
FEATURE_CASHIER=0
FEATURE_CARDS=0
FEATURE_CREDIT=0
WELCOME_BONUS_ENABLED=0
CREDIT_MIN_ACCOUNT_AGE_DAYS=30
CREDIT_MIN_BALANCE=10000
PRIVATE_MEDIA_ROOT=/srv/klosa/private_media
BACKUP_GPG_KEY=backup@bank.example.com