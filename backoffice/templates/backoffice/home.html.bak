{% extends 'base.html' %}
{% block title %}Staff · Klosa Bank{% endblock %}
{% block content %}
{% include "biller/_style.html" %}
<section class="bl">
  <header class="bl-head"><div><h1>Staff console</h1><p>{{ request.user.get_full_name|default:request.user.username }}</p></div></header>
  {% for message in messages %}<p class="bl-msg">{{ message }}</p>{% endfor %}
  <div class="bl-grid">
    {% for t in tiles %}
    <a class="bl-tile" href="{% url t.2 %}">
      <span class="bl-ico"><i class="fa-solid {{ t.3 }}"></i></span><b>{{ t.0 }}</b>
      <small>{% if t.1 is not None %}{{ t.1 }} waiting{% else %}Open{% endif %}</small>
      {% if t.1 %}<span class="bl-lock" style="background:rgba(0,229,255,.16);color:#00E5FF">{{ t.1 }}</span>{% endif %}
    </a>
    {% empty %}<p style="color:#9FB6E0">No tools are assigned to your role yet. Ask an administrator.</p>{% endfor %}
  </div>
  <form method="post" action="{% url 'accounts:logout' %}">{% csrf_token %}<button class="bl-btn ghost" type="submit">Log out</button></form>
</section>
{% endblock %}