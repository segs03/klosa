{% extends 'base.html' %}
{% block title %}Withdraw - Klosa Bank{% endblock %}
{% block content %}
{% include "biller/_style.html" %}
<style>.bl select.bl-in option{color:#000}</style>
<section class="bl">
  <header class="bl-head" data-r style="--d:0">
    <a class="bl-back" href="{% url 'accounts:home' %}" aria-label="Back"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg></a>
    <div><h1>Withdraw</h1><p>Send money to a bank account</p></div>
  </header>
  {% for message in messages %}<p class="bl-msg" role="status">{{ message }}</p>{% endfor %}
  <div class="bl-top" data-r style="--d:1"><small>Available balance</small><strong>₦{{ account.balance|floatformat:2 }}</strong></div>

  <form method="post" id="wdForm" novalidate style="margin-top:16px">
    {% csrf_token %}
    <input type="hidden" name="step" value="review">
    {% if recent %}
    <div class="bl-sec" data-r style="--d:2"><span class="bl-lbl">Recent</span>
      <div class="bl-quick">{% for p in recent %}<button type="button" class="payee" data-bank="{{ p.bank_name }}" data-num="{{ p.account_number }}">{{ p.account_name|truncatechars:16 }} ••{{ p.account_number|slice:"-4:" }}</button>{% endfor %}</div>
    </div>
    {% endif %}
    <div class="bl-sec" data-r style="--d:3">
      <label class="bl-lbl" for="id_bank_name">Bank</label>
      <select class="bl-in" id="id_bank_name" name="bank_name" required>
        {% for value, label in form.fields.bank_name.choices %}<option value="{{ value }}" {% if form.bank_name.value == value %}selected{% endif %}>{{ label }}</option>{% endfor %}
      </select>
      {% for e in form.bank_name.errors %}<p class="bl-err">{{ e }}</p>{% endfor %}
    </div>
    <div class="bl-sec" data-r style="--d:4">
      <label class="bl-lbl" for="id_account_number">Account number</label>
      <input class="bl-in" id="id_account_number" name="account_number" value="{{ form.account_number.value|default:'' }}" inputmode="numeric" maxlength="10" autocomplete="off" placeholder="10 digits" required>
      {% for e in form.account_number.errors %}<p class="bl-err">{{ e }}</p>{% endfor %}
    </div>
    <div class="bl-sec" data-r style="--d:5">
      <label class="bl-lbl" for="id_amount">Amount (₦)</label>
      <input class="bl-in" id="id_amount" name="amount" value="{{ form.amount.value|default:'' }}" inputmode="decimal" autocomplete="off" placeholder="0.00" required>
      <p class="bl-hint">Up to ₦{{ single|floatformat:0 }} per withdrawal{% if fee %} · fee ₦{{ fee|floatformat:2 }}{% endif %}</p>
      {% for e in form.amount.errors %}<p class="bl-err">{{ e }}</p>{% endfor %}
    </div>
    {% for e in form.non_field_errors %}<p class="bl-err">{{ e }}</p>{% endfor %}
    <button type="submit" class="bl-btn" id="wdGo">Continue</button>
  </form>
</section>
<script>
(() => {
  document.querySelectorAll(".payee").forEach((b) => b.addEventListener("click", () => {
    document.getElementById("id_bank_name").value = b.dataset.bank;
    document.getElementById("id_account_number").value = b.dataset.num;
  }));
  document.getElementById("wdForm").addEventListener("submit", () => {
    const b = document.getElementById("wdGo"); setTimeout(() => { b.disabled = true; b.textContent = "Checking…"; }, 0);
  });
})();
</script>
{% endblock %}